{
  "name": "software-engineer-contractor-template",
  "version": "1.0.0",
  "description": "A configurable engineering-services website with calendar booking and optional email enquiries.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "generate:phone-countries": "node scripts/generate-phone-countries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs && playwright test",
    "pricing:generate": "node scripts/generate-pricing.mjs",
    "pricing:check": "node scripts/generate-pricing.mjs --check",
    "predev": "npm run config:generate",
    "prebuild": "npm run config:generate",
    "pretest": "npm run config:generate",
    "test:pricing": "node --test scripts/pricing-workbook.test.mjs",
    "config:generate": "node scripts/generate-site.mjs && node scripts/generate-pricing.mjs",
    "pretypecheck": "npm run config:generate",
    "postbuild": "node scripts/clean-standalone.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@openpanel/web": "^1.4.1",
    "libphonenumber-js": "^1.13.15",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "private": true
}
