# Public canonical origin, also used for contact request origin validation.
SITE_URL=http://localhost:3000
# Opt in only for the public production deployment. Rebuild after changes.
SITE_INDEXING=false
# Public-facing content and prices; leave blank to use fictional examples.
# These paths are read at build time. Keep the real files outside Git.
SITE_CONFIG_PATH=
PRICING_WORKBOOK_PATH=
# Set all three to enable email delivery. Server-only; never put these in JSON.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Public OpenPanel browser client ID. The client secret is not needed for this setup.
OPEN_PANEL_CLIENT_ID=
